    },
    "Quit while CleanMate is still working?" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thoát khi CleanMate vẫn đang làm việc?"
          }
        }
      }
    },
    "Cleaning or moving to the Trash stops partway: what is done stays done, the rest is left as it is, and there is no Undo." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Việc dọn hoặc chuyển vào Thùng rác sẽ dừng giữa chừng: phần đã xong giữ nguyên, phần còn lại không bị đụng tới và không thể Hoàn tác."
          }
        }
      }
    },
    "Quit Anyway" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vẫn thoát"
          }
        }
      }
    },
