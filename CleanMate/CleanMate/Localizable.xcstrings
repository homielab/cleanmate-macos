      }
    },
    "%@ free on %@ → %@ on %@." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trống %1$@ ngày %2$@ → %3$@ ngày %4$@."
