    },
    "%lld Apps Ticked" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã chọn %lld ứng dụng"
          }
        }
      }
    },
    "Each app goes to the Trash with the data in your Library that surely belongs to it. Items marked “Possibly related” and config in your home folder are kept: select an app on its own to review them." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mỗi ứng dụng vào Thùng rác cùng dữ liệu trong Library chắc chắn là của nó. Mục ghi “Có thể liên quan” và cấu hình trong thư mục người dùng được giữ lại: chọn riêng từng ứng dụng để xem chúng."
          }
        }
      }
    },
    "Open apps are skipped. Quit them to uninstall them too." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ứng dụng đang mở sẽ bị bỏ qua. Thoát chúng để gỡ luôn."
          }
        }
      }
    },
