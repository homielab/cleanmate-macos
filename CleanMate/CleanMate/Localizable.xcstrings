          "stringUnit" : {
            "state" : "translated",
            "value" : "Đóng"
          }
        }
      }
    },
    "Desktop, Documents, Downloads and other protected folders are not scanned — grant Full Disk Access to scan them." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chưa quét Desktop, Documents, Downloads và các thư mục được bảo vệ khác — cấp Full Disk Access để quét."
          }
        }
      }
    },
    "Grant Full Disk Access to also check Downloads and external drives." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cấp Full Disk Access để kiểm thêm Downloads và ổ ngoài."
          }
        }
      }
    },
    "Photos in the Photos app's library are not checked." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thư viện của ứng dụng Ảnh không được quét."
          }
        }
      }
    },
    "Junk found: %@ · selected %@ (scanned %@)" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
