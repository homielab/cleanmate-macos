          }
        }
      }
    },
    "Everything in the Trash is deleted for good, also what you put there yourself. This can’t be undone." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mọi thứ trong Thùng rác bị xoá vĩnh viễn, kể cả những gì bạn tự bỏ vào. Không thể hoàn tác."
          }
        }
