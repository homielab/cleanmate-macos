    },
    "Extra copies: %@" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản thừa: %@"
          }
        }
      }
    },
    "Files and hidden names directly in ~/.cache" : {
      "localizations" : {
        "vi" : {
