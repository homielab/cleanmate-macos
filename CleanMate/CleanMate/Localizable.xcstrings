          }
        }
      }
    },
    "Encrypts the startup disk so it can't be read without your password." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mã hoá ổ khởi động để không ai đọc được nếu không có mật khẩu của bạn."
          }
        }
      }
    },
    "Engine binaries of Prisma versions, downloaded again when needed" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Engine của các phiên bản Prisma, sẽ được tải lại khi cần"
          }
        }
      }
    },
    "Environments of apps run with pipx run, made again on the next run" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Môi trường của ứng dụng chạy bằng pipx run; sẽ được tạo lại ở lần chạy sau"
          }
        }
      }
    },
    "Erases the apps and data of each ticked simulator (simctl erase); the simulators stay, empty as new" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xoá ứng dụng và dữ liệu của từng simulator được chọn (simctl erase); simulator vẫn còn, trống như mới"
          }
        }
      }
    },
    "Every copy is selected: no copy of %@ will be left. You can put them back from the Trash until it is emptied." : {
      "localizations" : {
        "vi" : {
