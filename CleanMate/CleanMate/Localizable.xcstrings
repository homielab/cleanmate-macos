    },
    "A notification when the startup disk runs low, checked when CleanMate opens, after Smart Scan and every hour while it runs; at most one a day." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thông báo khi ổ khởi động sắp đầy, kiểm tra khi mở CleanMate, sau Quét thông minh và mỗi giờ khi app đang chạy; tối đa một lần mỗi ngày."
          }
        }
      }
    },
    "A program runs from this version, so it is kept" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có chương trình đang chạy từ phiên bản này nên được giữ lại"
          }
        }
      }
    },
    "Abandoned downloads" : {
