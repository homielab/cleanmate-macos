    "Almost full" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sắp đầy"
          }
        }
      }
    },
    "Android emulator snapshots" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snapshot trình giả lập Android"
          }
        }
      }
    },
    "Android system images without a device" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System image Android không thiết bị nào dùng"
          }
        }
      }
    },
    "Anyone with your Mac can read its disk without your password. Turn FileVault on in Privacy & Security." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ai cầm máy Mac của bạn cũng đọc được ổ đĩa mà không cần mật khẩu. Bật FileVault trong Quyền riêng tư & Bảo mật."
          }
        }
      }
    },
    "Apps from anywhere open without a check. Turn Gatekeeper back on in Privacy & Security." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ứng dụng từ bất kỳ nguồn nào cũng mở được mà không bị kiểm tra. Bật lại Gatekeeper trong Quyền riêng tư & Bảo mật."
          }
        }
      }
    },
    "Apps with admin rights can change macOS system files. Turn it back on from macOS Recovery with “csrutil enable”." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ứng dụng có quyền quản trị có thể sửa tệp hệ thống của macOS. Bật lại từ macOS Recovery bằng lệnh “csrutil enable”."
          }
        }
      }
    },
    "At this rate the disk is full in about %lld weeks." : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "At this rate the disk is full in about %lld week."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "At this rate the disk is full in about %lld weeks."
                }
              }
            }
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Với tốc độ này, ổ sẽ đầy sau khoảng %lld tuần."
          }
        }
      }
    },
    "Automatically check for updates" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tự động kiểm tra cập nhật"
          }
        }
      }
    },
    "Automatically download and install updates" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tự động tải về và cài đặt bản cập nhật"
          }
        }
      }
    },
    "Bazel cache" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bộ nhớ đệm Bazel"
          }
        }
      }
    },
    "Blocked by a folder in Exclusions" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bị chặn bởi một thư mục trong Loại trừ"
          }
        }
      }
    },
    "Blocks unwanted incoming connections to apps on this Mac." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chặn kết nối đến không mong muốn tới các ứng dụng trên máy Mac này."
          }
        }
      }
    },
    "Build outputs and fetched packages, made again by the next build" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kết quả build và gói đã tải; lần build sau sẽ tạo lại"
          }
        }
      }
    },
    "Cached compiler outputs, made again by the next build" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kết quả biên dịch đã lưu; lần build sau sẽ tạo lại"
          }
        }
      }
    },
    "Check for Updates…" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiểm tra cập nhật…"
          }
        }
      }
    },
    "Checking for updates is CleanMate’s only network connection: it asks GitHub whether a new version is out. Nothing about you or your Mac is sent." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiểm tra cập nhật là kết nối mạng duy nhất của CleanMate: hỏi GitHub xem đã có phiên bản mới chưa. Không gửi gì về bạn hay máy Mac của bạn."
          }
        }
      }
    },
    "Checking…" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đang kiểm tra…"
          }
        }
      }
    },
    "Checks that apps you open come from the App Store or identified developers." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiểm tra ứng dụng bạn mở đến từ App Store hoặc nhà phát triển đã xác minh."
          }
        }
      }
    },
    "Chrome downloads it again when an AI feature is used" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chrome tải lại khi dùng tính năng AI"
          }
        }
      }
    },
    "Chromium builds for Windsurf's browser, downloaded again when it is opened" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản Chromium cho trình duyệt của Windsurf, sẽ được tải lại khi mở trình duyệt"
