          }
        }
      }
    },
    "Without Full Disk Access, macOS asks before each of Desktop, Documents, Downloads, Movies, Music, Pictures, iCloud Drive and other apps' data, so CleanMate leaves them out." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
