    "Unreadable entries: %lld (prune may still remove them)" : {
      "comment" : "Last row of a Docker list: records of docker system df that could not be read.",
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mục không đọc được: %lld (lệnh dọn vẫn có thể xoá chúng)"
          }
        }
      }
    },
    "Up to %@" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tối đa %@"
          }
        }
      }
    },
    "User caches" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bộ nhớ đệm người dùng"
