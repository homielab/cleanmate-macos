      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đặt lại lựa chọn"
          }
        }
      }
    },
    "Locked in Finder (turn off Locked in Get Info): %lld" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bị khoá trong Finder (tắt Khoá trong Lấy thông tin): %lld"
          }
        }
      }
    },
    "It is locked in Finder. Select it, choose File > Get Info, turn off Locked, then try again. Nothing was moved." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ứng dụng đang bị khoá trong Finder. Hãy chọn ứng dụng, vào Tệp > Lấy thông tin, tắt Khoá rồi thử lại. Chưa có gì được chuyển."
          }
        }
      }
    },
    "ZCode: remote server files" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ZCode: tệp máy chủ từ xa"
