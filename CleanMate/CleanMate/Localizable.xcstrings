{
  "sourceLanguage" : "en",
  "strings" : {
    "%@" : {
      "shouldTranslate" : false
    },
    "%@ came from the App Store: remove it in Launchpad or drag it to the Trash in Finder." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ cài từ App Store: hãy gỡ trong Launchpad hoặc kéo vào Thùng rác trong Finder."
          }
        }
      }
    },
    "%@ deleted permanently and can’t be recovered." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bị xoá hẳn, không thể khôi phục."
          }
        }
      }
    },
    "%@ didn’t quit" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ không thoát"
          }
        }
      }
    },
    "%@ free of %@" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Còn trống %1$@ / %2$@"
          }
        }
      }
    },
    "%@ free on %@ → %@ on %@." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trống %1$@ ngày %2$@ → %3$@ ngày %4$@."
          }
        }
      }
    },
    "%@ in the Trash, not freed until it is emptied" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ đang trong Thùng rác, chưa được giải phóng cho tới khi dọn sạch"
          }
        }
      }
    },
    "%@ measured" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã đo %@"
          }
        }
      }
    },
    "%@ to the Trash: you can put it back with Undo or from the Trash." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vào Thùng rác: lấy lại được bằng Hoàn tác hoặc từ Thùng rác."
          }
        }
      }
    },
    "%@ used of %@ · %@ available" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã dùng %1$@ / %2$@ · còn trống %3$@"
          }
        }
      }
    },
    "%@ used, %@ available of %@" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã dùng %1$@, còn trống %2$@ / %3$@"
          }
        }
      }
    },
    "%@ was not moved: you stopped before it." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ chưa được chuyển: bạn đã dừng trước khi tới ứng dụng này."
          }
        }
      }
    },
    "%@: %@ free" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: trống %2$@"
          }
        }
