        }
      }
    },
    "Find files with the same content anywhere in the scope, and keep one copy. Nothing is selected for you." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tìm các tệp có cùng nội dung ở mọi nơi trong phạm vi và giữ lại một bản. Không tệp nào được chọn sẵn."
          }
